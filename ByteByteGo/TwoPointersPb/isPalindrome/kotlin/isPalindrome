// T : O(n)
// S : few vars allocated: O(1)  

fun isPalindrome(str: String): Boolean?{
    if (str.length <= 0)  {println("Empty array"); return null}
    val punctuation = ",.;:_-?!'\""
    
    var start = 0
    var end = str.length - 1
    
        while(start < end){
            if (str[start] in punctuation) start++
			if (str[end]  in punctuation)  end--

            when{
                str[start] != str[end] -> {println(false); return false}
                else -> {                                   
                   start++
                   end--
                }                
            }            
        }		  
    println("true")
    return true
}


